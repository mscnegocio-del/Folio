        <td colspan="4" style="width:446.25pt; border:inset olive 1.0pt; padding:3.0pt 3.0pt 3.0pt 3.0pt" valign="top" width="595"> <p style="line-height:normal"><span style="font-size:10.0pt; font-family:Arial,sans-serif"><a href="/spij-ext-web/detallenorma/H682692" ng-click="scrollTo('JD_penal3')" style="text-decoration: underline;color: #008000; font-weight: bold">TITULO PRELIMINAR : Principios Generales</a></span></p>
 </td> 
       </tr> 
       <tr> 
        <td colspan="4" style="width:446.25pt; border:inset olive 1.0pt; padding:3.0pt 3.0pt 3.0pt 3.0pt" valign="top" width="595"> <p style="line-height:normal"><span style="font-size:10.0pt; font-family:Arial,sans-serif"><a href="/spij-ext-web/detallenorma/H682692" ng-click="scrollTo('JD_penal4')" style="text-decoration: underline;color: #008000; font-weight: bold">LIBRO PRIMERO : Parte General</a></span></p>
 </td> 
