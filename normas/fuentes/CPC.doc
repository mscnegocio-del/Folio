   </div>
   <div>
    <ul>
     <li><font style="font-size: 8pt;font-family: Arial;"><a href="/spij-ext-web/detallenorma/H42337" ng-click="scrollTo('REF_23528_1660077034021')" onclick="CerrarPopUp();" style="text-decoration: underline;color: #008000;font-weight: bold">CAS. 4978-2015-JUNÍN</a></font><span><br><span></span></span></li>
    </ul>
