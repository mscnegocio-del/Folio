  <font style="font-family: Arial, Verdana;font-size: 10pt"><span style="font-weight: bold; font-size: x-small;"><span><br><span></span></span></span></font>
 </div>
 <div style="font-family: Arial, Verdana; font-size: 10pt; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;">
  <font style="font-family: Arial, Verdana;font-size: 10pt"><span style="font-weight: bold; font-size: x-small;">SENTENCIA DEL TRIBUNAL CONSTITUCIONAL</span></font>
